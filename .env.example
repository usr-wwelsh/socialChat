# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/socialchat

# Server Configuration
PORT=3000
SESSION_SECRET=your-secret-key-here-change-this

# Environment
NODE_ENV=development

# Bot Configuration (RAG-powered AI bots)
BOT_ENABLED=false
GEMINI_API_KEY=your-gemini-api-key-here
BOT_POST_INTERVAL_MIN=25
BOT_POST_INTERVAL_MAX=35
BOT_CONTEXT_POST_LIMIT=20

# S3-Compatible Object Storage (optional — leave unset to use local filesystem)
# Supports Cloudflare R2, AWS S3, MinIO, etc.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_PUBLIC_URL=https://media.yourdomain.com
# S3_REGION=auto
